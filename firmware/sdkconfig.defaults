# ESP32-S3 Configuration Defaults

CONFIG_IDF_TARGET="esp32s3"
CONFIG_IDF_FIRMWARE_CHIP_ID=0x0009

# Memory
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_SIZE=16
CONFIG_ESP32S3_DATA_CACHE_SIZE=32

# Partition Table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# I2S
CONFIG_ESP_I2S_ENABLE_DEBUG_LOG=n

# SD Card
CONFIG_SDCARD_HOST_THREAD_PRIORITY=5

# WiFi
CONFIG_ESP_WIFI_SSID=""
CONFIG_ESP_WIFI_PASSWORD=""
CONFIG_ESP_MAXIMUM_RETAIN_RAM_SIZE=0x200000

# Power Management
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=y

# FreeRTOS
CONFIG_FREERTOS_UNICORE=n
CONFIG_FREERTOS_TICK_RATE_HZ=1000

# Logging
CONFIG_LOG_DEFAULT_LEVEL=2

# OTA Updates
CONFIG_APP_ROLLBACK_ENABLE=y
CONFIG_OTA_ALLOW_HTTP=y
